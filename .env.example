# GitLab Terraform State Registry auth - used directly by Terraform's http
# backend (read from the OS environment, not from this repo's HCL). Locally
# this is your own PAT; in CI it's gitlab-ci-token/$CI_JOB_TOKEN, set in
# .gitlab-ci.yml - no CI/CD variable needed there.
# - username: typically "gitlab-token"
# - password: GitLab Personal Access Token with access to the Terraform State Registry
TF_HTTP_USERNAME=gitlab-token
TF_HTTP_PASSWORD=

# GitLab Owner-level token (api scope) - backs the `gitlab` Terraform provider
# (creates Service Accounts/projects group-wide under from-the-lamp) and
# cross-project OCI pulls (helm charts, terraform modules - both published
# by OTHER projects). Deliberately separate from TF_HTTP_PASSWORD above -
# a GitLab CI job token can satisfy that one but never this one.
#
# Locally: your own human Owner-level PAT - this is the ONLY place that PAT
# is needed, and only to bootstrap homelab/gitlab/automation/bot the very
# first time (nothing can grant a service account group Owner without an
# already-Owner-level caller). After that first apply, that unit's own
# gitlab_project_variable writes its bot's current token straight into this
# project's GITLAB_API_TOKEN CI/CD variable (created there, refreshed on
# every rotation) - CI (plan and apply alike) just reads it normally, no
# fetch step, no Vault involved for this. Set it as a real masked CI/CD
# variable in this project's Settings > CI/CD > Variables - NOT protected,
# or MR pipelines (unprotected branches) won't see it.
GITLAB_API_TOKEN=

# Cloudflare API access
CLOUDFLARE_API_TOKEN=

# OAuth/OpenID secrets (Cloudflare Access / OAuth proxy, if used)
OPENID_CLIENT_SECRET_CLOUDFLARE=
OPENID_CLIENT_ID_CLOUDFLARE=

# Tailscale API access
TAILSCALE_TAILNET=
TAILSCALE_API_KEY=

# Kubernetes access for shared infra cluster (used by some modules)
INFRA_K8S_HOST=
INFRA_K8S_CERTIFICATE=
INFRA_K8S_TOKEN=

# Kubernetes access for prod-0 cluster (used by some modules)
PROD-0_K8S_HOST=
PROD-0_K8S_CERTIFICATE=
PROD-0_K8S_TOKEN=

# HashiCorp Vault (homelab) - leave both blank, `task vault:login` fills
# them in via OIDC (requires being on the tailnet, vault.from-the-lamp.work
# is Tailscale-only)
VAULT_ADDR=
VAULT_TOKEN=
